[Unit]
Description=VirtualDrive Industrial Protocol Simulator
Documentation=https://github.com/VirtualDrive/docs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Disable RT throttling so SCHED_FIFO threads can run without cgroup budget limits.
# Required when CONFIG_RT_GROUP_SCHED=y (our kernel config) and systemd does not
# allocate cpu.rt_runtime_us to the service cgroup.
ExecStartPre=-/sbin/sysctl -w kernel.sched_rt_runtime_us=-1
ExecStart=/usr/bin/drive-simulator --protocol ethercat --interface eth0
Restart=on-failure
RestartSec=5s

# Memory locking: the cyclic thread calls mlockall() but the service also
# needs the capability to do so
LimitMEMLOCK=infinity

# Raw socket access for EtherCAT (requires CAP_NET_RAW)
AmbientCapabilities=CAP_NET_RAW CAP_SYS_NICE CAP_IPC_LOCK
CapabilityBoundingSet=CAP_NET_RAW CAP_SYS_NICE CAP_IPC_LOCK

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=drive-simulator

[Install]
WantedBy=multi-user.target
